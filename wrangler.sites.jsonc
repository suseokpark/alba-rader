{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alba-rader",
  "main": ".svelte-kit/cloudflare/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "send_metrics": false
}
