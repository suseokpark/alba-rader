{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alba-rader",
  "main": ".svelte-kit/cloudflare/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "send_metrics": false,
  "d1_databases": [{ "binding": "DB", "database_name": "alba-clicks-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "drizzle" }]
}
